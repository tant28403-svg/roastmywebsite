# =============================================================================
# Roast My Website - .gitignore
#
# Track only what is required to clone and run the tool. Everything created
# locally by installation, running, testing, or scanning is ignored.
# =============================================================================

# --- Everything ignored by default -------------------------------------------
# Track nothing unless it is explicitly allowed further down.
# Directories and files that matter are re-included with `!` rules at the end.
*
!.gitignore
!.gitattributes
!LICENSE
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!Makefile
!Dockerfile
!pyproject.toml
!config.example.yaml

# --- Repository directories that must stay -----------------------------------
# Only source, tests, packaging and the install scripts are needed to run the tool.
!scripts/
!scripts/**
!src/
!src/**
!tests/
!tests/**
!wordlists/
!wordlists/.gitkeep

# --- Not needed to run the tool (kept out of the clone) ----------------------
# These still work on GitHub if you re-add them later, but they are ignored
# so a fresh clone only contains what is required to run.
.github/
docs/
examples/

# --- Allowed individual files inside src -------------------------------------
# (covered by `!src/**`, listed here only for clarity)

# =============================================================================
# Local installation and Python artefacts
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
pythonenv*/
.tox/
.nox/
.direnv/
.envrc
pip-wheel-metadata/
share/python-wheels/
site-packages/
pip-log.txt

# =============================================================================
# Build, packaging and distribution output
# =============================================================================
build/
dist/
sdist/
*.egg-info/
*.egg
.eggs/
wheelhouse/
*.whl
*.tar.gz
MANIFEST

# =============================================================================
# Test, lint, type-check and coverage output
# =============================================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.cache/
.cache_*/
.coverage
.coverage.*
coverage.xml
nosetests.xml
junit*.xml
htmlcov/
.benchmarks/
prof/
profile-*.txt

# =============================================================================
# Roast My Website runtime data
# =============================================================================
.roastmywebsite/
.docker-data/
reports/
scans/
scan-*/
results/
output/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sarif
results*.json
roast*.json

# =============================================================================
# Local configuration, secrets and credentials
# =============================================================================
.env
.env.*
!.env.example
config.yaml
config.local.yaml
proxies.txt
proxies.enc
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
id_rsa*
known_hosts
.aws/
.ssh/
.netrc
credentials*.json
serviceaccount*.json
*api-key*
*apikey*
*secrets*.json
*credentials*.yaml

# =============================================================================
# External tool output
# =============================================================================
nmap*.xml
nmap*.txt
nmap*.gnmap
nmap*.nmap
masscan*.json
nuclei*.jsonl
nuclei-results*
subfinder*.txt
naabu*.txt
ffuf*.json
amass*.txt

# =============================================================================
# Custom wordlists and downloaded template packs
# =============================================================================
wordlists/*
!wordlists/.gitkeep
nuclei-templates/
custom-templates/
templates-custom/

# =============================================================================
# Logs and temporary files
# =============================================================================
*.log
*.log.*
*.pid
*.seed
*.pid.lock
*.bak
*.orig
*.rej
*.tmp
*.temp
*.swp
*.swo
*.patch
*.diff
*~
*.stackdump

# =============================================================================
# Editor, IDE, notebook and OS files
# =============================================================================
.vscode/
.idea/
*.iml
*.suo
*.user
*.code-workspace
*.sublime-*
.ipynb_checkpoints/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Re-include files that are required for the tool to work
# =============================================================================
!wordlists/.gitkeep
